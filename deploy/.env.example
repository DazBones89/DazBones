# Copy to deploy/.env. Use new random values, never reuse historical local codes.
SITE_HOST=team.example.com
DB_PASSWORD=replace-with-random-32-characters
DB_ROOT_PASSWORD=replace-with-different-random-32-characters
ADMIN_CODE=replace-with-new-random-admin-code
EDITOR_CODE=replace-with-new-random-editor-code
HTTP_PORT=80
HTTPS_PORT=443
